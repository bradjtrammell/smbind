# Export these through PHP-FPM pool environment or a secret manager, not the public web root.
SMBIND_DSN="mysql:host=127.0.0.1;port=3306;dbname=smbind;charset=utf8mb4"
SMBIND_DB_USER="smbind_app"
SMBIND_DB_PASS=""
SMBIND_SECURE_COOKIES="1"
SMBIND_ZONE_DIR="/var/lib/smbind/zones"
SMBIND_INCLUDE_FILE="/etc/bind/smbind-managed/zones.conf"
SMBIND_NAMED_CONF="/etc/bind/named.conf"
SMBIND_NAMED_CHECKZONE="/usr/sbin/named-checkzone"
SMBIND_NAMED_CHECKCONF="/usr/sbin/named-checkconf"
SMBIND_RNDC="/usr/sbin/rndc"
